# ── Database (PostgreSQL + PostGIS) ─────────────────────────────
POSTGRES_USER=sakay
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sakay
# Used by the api container directly; docker-compose builds this for you
# from the three vars above, but Prisma also needs it when run locally:
DATABASE_URL=postgresql://sakay:change-me@localhost:5432/sakay?schema=public

# ── Redis (Socket.IO adapter + caching) ─────────────────────────
REDIS_URL=redis://localhost:6379

# ── App JWT (issued after Firebase login, used for REST + sockets) ─
JWT_SECRET=generate-a-long-random-string-here

# ── Firebase (Auth, Cloud Messaging, Storage) ───────────────────
# Console: https://console.firebase.google.com -> Project settings -> Service accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escape sequences literal in this file; auth.module.ts un-escapes them.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Cloudflare R2 (bulk media storage) ──────────────────────────
# Dashboard: Cloudflare -> R2 -> Manage API tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sakay-uploads

# ── PayMongo (card + GCash source) ──────────────────────────────
# Dashboard: https://dashboard.paymongo.com -> Developers -> API Keys
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=

# ── Stripe (optional international cards) ───────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Misc ─────────────────────────────────────────────────────────
PORT=4000
APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000/api/v1
